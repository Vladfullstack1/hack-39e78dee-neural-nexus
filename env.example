# Gemini is optional. The project works in deterministic local mode without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_LLM=false
GEMINI_TIMEOUT_SECONDS=4.0

# Fill these with the current model prices (USD per 1M tokens) before reporting costs.
GEMINI_INPUT_USD_PER_1M=0.075
GEMINI_OUTPUT_USD_PER_1M=0.30

APP_HOST=0.0.0.0
APP_PORT=8000
RULES_PATH=data/rules.json
TAXONOMY_PATH=data/taxonomy.json
DUPLICATE_TTL_SECONDS=3600
